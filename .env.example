# name.com sandbox (api.dev.name.com) — username must end in "-test"
NAMECOM_SANDBOX_USERNAME=yourusername-test
NAMECOM_SANDBOX_TOKEN=your_sandbox_token_here

# name.com production (api.name.com)
NAMECOM_PROD_USERNAME=yourusername
NAMECOM_PROD_TOKEN=your_production_token_here

# Logging level (Python logging module name). Safe to leave unset — defaults to INFO.
# LOG_LEVEL=INFO

# name_client.py: 429 retry behavior.
# NAMECOM_RATE_LIMIT_MAX_RETRIES=3
# NAMECOM_RATE_LIMIT_MAX_AUTO_WAIT_SECONDS=15

# pipeline.py: off by default so this deployment never risks a real purchase. Only set this to
# true on a deployment using your OWN production credentials if you deliberately want real
# domain registration enabled.
# NAMECOM_ALLOW_PRODUCTION_REGISTRATION=false

# GMI Cloud API key — single key for all GMI Cloud services
# https://console.gmicloud.ai/user-setting/ie/api-keys
GMI_API_KEY=your_gmi_api_key_here
# GMI_CLOUD_ENABLED=true
# GMI_MUSIC_MODEL=minimax-music-3.0
# GMI_TTS_VOICE=English_Graceful_Lady
# GMI_TTS_MODEL=minimax-tts-speech-2.8-hd
# GMI_VIDEO_MODEL=minimax/h3-max
# GMI_VIDEO_DURATION=5
# GMI_CHAT_BASE_URL=https://api.gmi-serving.com/v1
# GMI_CHAT_MODEL=MiniMaxAI/MiniMax-M3
# TTS_AUTOPLAY_DEADLINE_SECONDS=5

GRADIO_ANALYTICS_ENABLED=False
GRADIO_DEFAULT_CONCURRENCY_LIMIT=none
